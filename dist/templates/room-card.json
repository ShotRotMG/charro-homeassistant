      {
        "--mdc-icon-size": "24px"
      },
      {
        "justify-self": "start"
      },
      {
        "color": "[[[\n  const all = [].concat(variables.light_entities || [], variables.landscape_entities || []);\n  const on = all.some(e => states[e]?.state === 'on');\n  return on ? 'var(--green-color, #4caf50)' : 'var(--primary-text-color)';\n]]]\n"
      }
