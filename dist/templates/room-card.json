      },
      {
        "min-width": "100% !important"
      },
      {
        "height": "100% !important"
      },
      {
        "box-sizing": "border-box"
      },
      {
        "min-height": "63px"
      }
    ],
    "grid": [
      {
        "grid-template-areas": "\"i n alert\" \"chips chips chips\""
