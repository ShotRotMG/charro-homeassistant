      {
        "text-overflow": "ellipsis"
      },
      {
        "max-width": "100%"
      },
      {
        "min-width": "0"
      },
      {
        "font-size": "[[[\n  const n = Math.max((variables.room_name || '').length, 1);\n  /* 86px = icon col + alert col + gaps + card padding */\n  return `clamp(11px, calc((100cqw - 86px) / ${n} * 1.6), 18px)`;\n]]]"
